# cf-slayer 配置。复制为 .env，按需取消注释。
# 全部可选；注释中的默认值就是服务当前使用的值。

# CF_SLAYER_HOST=127.0.0.1
# CF_SLAYER_PORT=8878

# 缓存 TTL 上限（秒）。真实 cf_clearance 饼干更早过期时以饼干为准。
# CF_SLAYER_TTL_SECONDS=1800

# /solve 总预算与浏览器等待预算。
# CF_SLAYER_SOLVE_TIMEOUT=120
# CF_SLAYER_CHALLENGE_TIMEOUT=90
# CF_SLAYER_POLL_INTERVAL=2

# /replay 请求超时。
# CF_SLAYER_REPLAY_TIMEOUT=30

# CF_SLAYER_CACHE_PATH=cache.sqlite3
# CF_SLAYER_HEADLESS=true

# 有序后端链。运行环境缺失的后端会被跳过。
# CF_SLAYER_BACKENDS=camoufox,pydoll
# pydoll 后端使用的 Chrome/Chromium 二进制（空 = 常见路径 + PATH）。
# CF_SLAYER_CHROME_PATH=

# 后台预热：逗号分隔的域名或 URL，在过期前续期。
# CF_SLAYER_PREWARM_DOMAINS=steamdb.info,example.com
# 缓存凭据剩余秒数低于此值时续期。
# CF_SLAYER_PREWARM_MARGIN=300
# 两轮预热之间的间隔秒数。
# CF_SLAYER_PREWARM_INTERVAL=60

# 缺失时首次运行自动生成。显式设置可固定令牌。
# CF_SLAYER_AUTH_TOKEN=
