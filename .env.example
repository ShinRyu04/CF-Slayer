# cf-slayer configuration. Copy to .env and uncomment what you need.
# Everything is optional; the defaults shown are what the service uses.

# CF_SLAYER_HOST=127.0.0.1
# CF_SLAYER_PORT=8878

# Cache TTL ceiling in seconds (a real cf_clearance cookie wins if it expires sooner).
# CF_SLAYER_TTL_SECONDS=1800

# Overall /solve budget and browser wait budget.
# CF_SLAYER_SOLVE_TIMEOUT=120
# CF_SLAYER_CHALLENGE_TIMEOUT=90
# CF_SLAYER_POLL_INTERVAL=2

# /replay request timeout.
# CF_SLAYER_REPLAY_TIMEOUT=30

# CF_SLAYER_CACHE_PATH=cache.sqlite3
# CF_SLAYER_HEADLESS=true

# Ordered backend chain. A backend whose runtime is missing is skipped.
# CF_SLAYER_BACKENDS=camoufox,pydoll
# Chrome/Chromium binary for the pydoll backend (empty = common paths + PATH).
# CF_SLAYER_CHROME_PATH=

# Background prewarm: comma-separated domains or URLs renewed before expiry.
# CF_SLAYER_PREWARM_DOMAINS=steamdb.info,example.com
# Renew when less than this many seconds remain on the cached credential.
# CF_SLAYER_PREWARM_MARGIN=300
# Seconds between prewarm passes.
# CF_SLAYER_PREWARM_INTERVAL=60

# Generated automatically on first run if absent. Set it explicitly to pin a token.
# CF_SLAYER_AUTH_TOKEN=
